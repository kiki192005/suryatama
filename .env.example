# Environment Variables Example for PT. Suryatama Indonesia Website
# Copy this file to .env.local and fill in the values

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact Form Email Configuration (for Phase 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=info@suryatama-indonesia.co.id
